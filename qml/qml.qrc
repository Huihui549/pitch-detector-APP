<!DOCTYPE RCC>
<!--
  QML 璧勬簮娓呭崟锛坬make 鏂规锛?

  鎶?qml/ 鐩綍鎸?/PitchDetector 鍓嶇紑缂栬繘鍙墽琛屾枃浠讹紝璧勬簮鍐呭竷灞€锛?
      :/PitchDetector/qmldir
      :/PitchDetector/Main.qml
      :/PitchDetector/components/...
      :/PitchDetector/pages/...

  main.cpp 閲?addImportPath(":/") + loadFromModule("PitchDetector", "Main")銆?

  娉ㄦ剰锛歲make 涓嶄細鑷姩鐢熸垚 qmldir锛堥偅鏄?CMake 鐨?qt_add_qml_module 鎵嶅仛鐨勪簨锛夛紝
  qml/qmldir 鐢辨湰宸ョ▼鎵嬪伐缁存姢锛屾柊澧?QML 鏂囦欢鏃跺繀椤诲湪杩欓噷涓?qmldir 涓悓姝ョ櫥璁般€?
-->
<RCC>
    <qresource prefix="/PitchDetector">
        <file>qmldir</file>
        <file>Main.qml</file>
        <file>components/ActionButton.qml</file>
        <file>components/BottomNavBar.qml</file>
        <file>components/CentsBar.qml</file>
        <file>components/Chip.qml</file>
        <file>components/Icon.qml</file>
        <file>components/IconButton.qml</file>
        <file>components/LevelMeter.qml</file>
        <file>components/NoteDisplay.qml</file>
        <file>components/PageHeader.qml</file>
        <file>components/PageScroller.qml</file>
        <file>components/StatCard.qml</file>
        <file>components/ValueSlider.qml</file>
        <file>pages/DebugPage.qml</file>
        <file>pages/FilePage.qml</file>
        <file>pages/LivePage.qml</file>
        <file>pages/MetronomePage.qml</file>
        <file>pages/MorePage.qml</file>
    </qresource>
</RCC>
